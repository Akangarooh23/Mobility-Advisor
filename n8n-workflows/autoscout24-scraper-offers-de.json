      "parameters": {
        "language": "javaScript",
        "jsCode": "// Alimentacion GRADUAL: unas pocas marcas por pasada, avanzando un cursor que\n// vive en Postgres. Cubre las 45 marcas y vuelve a empezar, o sea refresco\n// continuo.\nconst makes = [9,13,47,74,64,60,55,21,54,29,70,39,33,52,28,16360,65,73,46,31,16338,51802,38,15641,43,68,50,6,16415,37,57,51520,15525,67,66,48,19,20,16396,45,27,42,16355,35,14882];\nconst buckets = [[0,3000],[3000,5000],[5000,7000],[7000,9000],[9000,11000],[11000,13000],[13000,15000],[15000,18000],[18000,22000],[22000,27000],[27000,35000],[35000,50000],[50000,80000],[80000,99999999]];\n\n// Marcas por pasada. Cada una son sus 14 tramos de precio y unos 40 minutos.\n// A 3 por pasada y 2 pasadas al dia, las 45 marcas entran en una semana. El\n// ritmo de peticiones NO cambia -sigue siendo una pagina por segundo-: lo que\n// cambia es cuanto dura la pasada, no lo fuerte que pegamos al portal.\nconst MAKES_PER_NIGHT = 3;\n\n// El cursor viene de la base, no de la memoria del workflow. Ver el comentario\n// del nodo \"PG: Por donde ibamos\".\nconst fila = $('PG: Por dónde íbamos').first().json || {};\nlet cursor = Number(fila.cursor);\nif (!Number.isFinite(cursor) || cursor < 0 || cursor >= makes.length) cursor = 0;\n\nconst siguiente = (cursor + MAKES_PER_NIGHT) % makes.length;\nconst sqlCursor = \"UPDATE moveadvisor_cursores SET valor = \" + siguiente\n  + \", actualizado = NOW() WHERE clave = 'as24_de_marca'\";\n\nconst out = [];\nfor (let m = 0; m < MAKES_PER_NIGHT; m++) {\n  const mk = makes[(cursor + m) % makes.length];\n  for (const b of buckets) out.push({ json: { mk: mk, pf: b[0], pt: b[1], sqlCursor: sqlCursor } });\n}\nconsole.log('[as24-de] marcas ' + cursor + '..' + (cursor + MAKES_PER_NIGHT - 1)\n  + ' de ' + makes.length + ' -> ' + out.length + ' segmentos. La proxima empieza en la ' + siguiente + '.');\nreturn out;"
      },
