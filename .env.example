GEMINI_API_KEY=AIzaSyxxxx

# Neon / Vercel Postgres (opcional; si se configura, auth y catálogo usan PostgreSQL)
# Neon inyecta DATABASE_URL automáticamente; Vercel Postgres usa POSTGRES_URL
# AUTH_PROVIDER puede dejarse en blanco: se detecta automáticamente si existe DATABASE_URL
DATABASE_URL=
POSTGRES_URL=

# Auth en SQL Server (opcional; si no se configura usa JSON local)
# AUTH_PROVIDER=sqlcmd-windows usa autenticación de Windows (SQLCMD -E)
# AUTH_PROVIDER=mssql usa usuario/contraseña SQL
AUTH_PROVIDER=local
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQLCMD_PATH=
AUTH_SESSION_TTL_HOURS=24
AUTH_SESSION_CLEANUP_PROBABILITY=0.2
AUTH_SESSION_SECRET=
AUTH_EXPOSE_RESET_CODE=false
AUTH_REQUIRE_EMAIL_DELIVERY=false
AUTH_RESET_REQUEST_WINDOW_MS=900000
AUTH_RESET_REQUEST_MAX_PER_EMAIL=3
AUTH_RESET_REQUEST_MAX_PER_IP=10
AUTH_RESET_CONFIRM_WINDOW_MS=600000
AUTH_RESET_CONFIRM_MAX_PER_EMAIL=8
AUTH_RESET_CONFIRM_MAX_PER_IP=20
AUTH_RESET_BACKOFF_BASE_MS=30000
AUTH_RESET_BACKOFF_MAX_MS=900000
AUTH_SECURITY_LOG_ENABLED=true
AUTH_SECURITY_STATUS_ENABLED=false
AUTH_BILLING_REQUIRE_SESSION=true

# Email real de alertas (opcional)
# Si no configuras esta clave, MoveAdvisor seguirá en modo local/simulado.
RESEND_API_KEY=
# Usa un dominio verificado en Resend (no onboarding@resend.dev, que solo entrega al dueño de la cuenta)
ALERT_EMAIL_FROM="YourBrand <noreply@yourdomain.com>"
ALERT_EMAIL_PROVIDER=resend

# Stripe billing (opcional)
# Sin estas variables, checkout y portal funcionan en modo simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=

# CarsWise Check — captura guiada e informe de estado (opcional)
# Sin la clave, la sección "Informe de estado" del IDCar avisa de que no está
# configurada. La clave es de servicio: solo la usa el backend, nunca el cliente.
CARSWISE_CHECK_URL=https://captura.carswiseai.com
CARSWISE_CHECK_INTERNAL_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Las que faltaban
#
# Una auditoría del 26/08/2026 encontró treinta y tres variables que el servidor
# pide y que no estaban aquí. Este fichero es el único mapa de lo que hace falta
# para levantar el proyecto: lo que no aparece, el día que alguien monte el
# despliegue de nuevo se pierde sin que nadie se entere, y casi ninguna avisa al
# faltar — se limitan a apagar la función que sostienen.
#
# Van vacías a propósito: esto documenta, no configura.
# ─────────────────────────────────────────────────────────────────────────────

# Tareas programadas. Sin secreto, las tres solo aceptan la llamada de Vercel
# Cron; con él, se exige en la cabecera Authorization.
CRON_SECRET=
# Interruptor de emergencia: a 0 se callan las tres. Para el día que haya un
# segundo despliegue contra la misma base y se dupliquen los avisos.
CRON_ACTIVO=
# Llave de servicio para reintentar a mano un aviso atascado.
INTERNAL_API_KEY=

# Sesión y acceso
AUTH_COOKIE_SECURE=
AUTH_LOCAL_RESET_FALLBACK=

# Direcciones públicas. Se usan para armar los enlaces de los correos: si están
# mal, el aviso llega pero lleva a ninguna parte.
APP_BASE_URL=
PUBLIC_SITE_URL=
SITE_URL=
NEXT_PUBLIC_BASE_URL=

# Correo
RESEND_FROM_EMAIL=
INTERNAL_ALERT_EMAIL=
INTERNAL_LEADS_EMAIL=

# Almacenamiento de ficheros (Supabase). Sin esto, subir una foto o un documento
# al IDCar devuelve "storage_not_configured".
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ATTACHMENT_STORAGE_MODE=
ATTACHMENT_STORAGE_DIR=

# ERP. Sin esto las citas se guardan aquí pero no llegan al taller.
ERP_API_URL=
ERP_SERVICE_TOKEN=
ERP_CATALOG_PROVIDER=
VEHICLE_CATALOG_PROVIDER=
INVENTORY_PROVIDER=

# Planes y pagos
BILLING_PLANS_JSON=
BILLING_DEFAULT_PLAN_ID=
STRIPE_PRICE_VALUATION=

# Talleres y mapas
GOOGLE_PLACES_KEY=

# WhatsApp (Meta)
META_WA_TOKEN=
META_WA_VERIFY_TOKEN=
META_WA_PHONE_ID_GENERAL=
META_WA_PHONE_ID_VO=
CARSWISE_PHONE=
OPS_EMAIL=

# Buscador de anuncios
FIND_LISTING_AGGRESSIVE_SCRAPING=

# --- Correo: quien lo manda y a donde vuelve ---------------------------------
# Todo lo que sale por Resend pasa por lib/marca.js. Una variable cambia todos
# los envios: contrasenas, facturas, citas, alertas y leads.

# El remitente. Tiene que ser un dominio verificado en Resend o el correo rebota.
RESEND_FROM_EMAIL="PopCar <notifications@popcar.tech>"

# La direccion de contacto: reply_to de los correos, destinatario de los avisos
# internos y pie de las facturas en PDF. Sin ella no se manda nada a ninguna
# parte y la factura ensena solo la web, que es preferible a ensenar un buzon
# que no recibe.
CONTACT_EMAIL="tu@dominio.com"

# Solo si hace falta separar. Sin estas, todo cae en CONTACT_EMAIL.
# REPLY_TO_EMAIL=
# INTERNAL_EMAIL=
# INTERNAL_LEADS_EMAIL=
# INTERNAL_ALERT_EMAIL=
# OPS_EMAIL=

# La cuenta que ve el garaje de demostracion. Sin ella no lo ve nadie.
# DEMO_GARAGE_EMAIL=
