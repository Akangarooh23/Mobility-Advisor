      "name": "2 veces/día (8:40 y 20:40)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -600,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Por dónde iba la última pasada y cuántas páginas tenía el portal.\n--\n-- En Postgres y no en $getWorkflowStaticData, que se reinicia al reimportar.\nSELECT clave, valor FROM moveadvisor_cursores\nWHERE clave IN ('ocasionplus_pagina', 'ocasionplus_paginas')",
        "options": {}
      },
      "id": "op-o-cursor",
      "name": "PG: Por dónde íbamos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "uG6rcC7AqSKyEJOW",
          "name": "Postgres account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "url": "https://www.ocasionplus.com/coches-segunda-mano",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
            },
            {
              "name": "Accept",
              "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            },
            {
              "name": "Accept-Language",
              "value": "es-ES,es;q=0.9"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "op-o-contar",
      "name": "HTTP: Contar el catálogo",
      "onError": "continueRegularOutput",
      "executeOnce": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reparte el catálogo en ventanas de páginas.\nconst PAGINAS = 100;\nconst SEGMENTOS = 8;\nconst TOPE = 2000;\nconst POR_PAGINA = 20;\n\nconst filas = $('PG: Por dónde íbamos').all().map(x => x.json);\nconst mapa = {};\nfor (const f of filas) mapa[f.clave] = Number(f.valor);\n\n// Cuántos coches tiene HOY, medido en vivo: lo dice su propio JSON-LD, en el\n// bloque Product, como offerCount.\nconst res = $input.first().json;\nconst html = String(res.data || res.body || '');\nlet total = 0;\nfor (const trozo of html.split('application/ld+json').slice(1)) {\n  const ini = trozo.indexOf('>');\n  const fin = trozo.indexOf('</script>');\n  if (ini === -1 || fin === -1) continue;\n  let j = null;\n  try { j = JSON.parse(trozo.slice(ini + 1, fin).trim()); } catch (e) { continue; }\n  if (j && j['@type'] === 'Product' && j.offers && Number(j.offers.offerCount) > 0) {\n    total = Number(j.offers.offerCount);\n    break;\n  }\n}\n\nlet paginas = total > 0 ? Math.ceil(total / POR_PAGINA) : 0;\n// Si el portal no contesta, se tira del último número conocido: quedarse sin\n// medida no debe dejar la pasada sin hacer nada.\nif (!(paginas > 0)) paginas = Number(mapa['ocasionplus_paginas']) || 0;\npaginas = Math.min(paginas, TOPE);\n\nif (!(paginas > 0)) {\n  console.log('[ocasionplus] no sé cuántas páginas hay y no había número guardado. Nada que repartir.');\n  return [{ json: { desde: 0, hasta: 0, sqlCursor: null } }];\n}\n\nlet pag = Number(mapa['ocasionplus_pagina']);\nif (!Number.isFinite(pag) || pag < 1 || pag > paginas) pag = 1;\n\nconst out = [];\nwhile (out.length < SEGMENTOS && pag <= paginas) {\n  out.push({ json: { desde: pag, hasta: Math.min(pag + PAGINAS - 1, paginas) } });\n  pag += PAGINAS;\n}\n// Si se ha llegado al final, la próxima empieza otra vez por el principio.\nconst siguiente = pag > paginas ? 1 : pag;\n\n// Se apunta ANTES de scrapear: si la pasada se cae a la mitad, la siguiente\n// sigue avanzando en vez de repetir lo mismo.\nconst sqlCursor = \"INSERT INTO moveadvisor_cursores (clave, valor, actualizado) VALUES \"\n  + \"('ocasionplus_pagina', \" + siguiente + \", NOW()), \"\n  + \"('ocasionplus_paginas', \" + paginas + \", NOW())\"\n  + \" ON CONFLICT (clave) DO UPDATE SET valor = EXCLUDED.valor, actualizado = NOW()\";\nfor (const o of out) o.json.sqlCursor = sqlCursor;\n\nconsole.log('[ocasionplus] ' + total + ' coches en ' + paginas + ' páginas. ' + out.length\n  + ' ventanas de ' + PAGINAS + ', de la ' + out[0].json.desde + ' a la '\n  + out[out.length - 1].json.hasta + '. La próxima pasada empieza en la ' + siguiente + '.');\nreturn out;"
      },
      "id": "op-o-gen",
      "name": "Code: Generar segmentos (ventanas de páginas)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sqlCursor }}",
        "options": {}
      },
      "id": "op-o-guardar",
