{
  "name": "Mantenimiento – Marcar ofertas activas/inactivas",
  "nodes": [
    {
      "parameters": {},
      "id": "mant-manual",
      "name": "Ejecutar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 7 * * *"
            }
          ]
        }
      },
      "id": "mant-cron",
      "name": "Cada día a las 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Limpieza diaria: borrar ofertas basura de mercado (precio < 2000 EUR)\nDELETE FROM moveadvisor_market_offers WHERE price < 2000;\n\n-- NOTA: is_active lo gestionan los verificadores URL a URL (verify-liveness.js\n-- cada 3h para todos los portales, as24-verify-liveness.js cada 4h para AS24,\n-- y el verificador de Flexicar). El umbral por last_seen_at se eliminó porque\n-- era redundante y pisaba los resultados de los verificadores.",
        "additionalFields": {}
      },
      "id": "mant-pg",
      "name": "PG: Recalcular is_active",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        260,
        390
      ],
      "credentials": {
        "postgres": {
          "id": "REEMPLAZA_CON_TU_ID_CREDENCIAL",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Ejecutar manualmente": {
      "main": [
        [
          {
            "node": "PG: Recalcular is_active",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cada día a las 7:00": {
      "main": [
        [
          {
            "node": "PG: Recalcular is_active",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": false,
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "triggerCount": 1,
  "tags": []
}